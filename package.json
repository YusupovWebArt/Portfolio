{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  },
  "resolutions": {
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:next": "next dev",
    "build:next": "next build",
    "start:next": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:all": "pnpm test && pnpm test:e2e",
    "audit:lhci": "lhci autorun",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "verify:live": "node scripts/verify-live-deployment.mjs",
    "verify": "pnpm exec tsc --noEmit && pnpm lint && pnpm test:all && pnpm audit --prod --audit-level=high && pnpm build && pnpm check:budget",
    "preview": "vite preview",
    "deploy": "node scripts/prepare-gh-pages.mjs && gh-pages -d dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/react": "^4.0.152",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "ai": "7.0.148",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}